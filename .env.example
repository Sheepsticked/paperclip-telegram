# Image to build and run: bot (default) or voice (adds local speech-to-text).
BOT_TARGET=bot
# User id of the account that owns ./config and ./state (run `id -u`).
PUID=1000
# Group id of that account (run `id -g`).
PGID=1000
# Whisper model baked into the voice image; set voice.model in the config to the same name.
WHISPER_MODEL=small
